#!/usr/bin/env bash
set -euo pipefail

if [[ ! -d ./.git ]]; then
  echo "Error: ./.git directory not found. Run this from the root of a non-bare git repository." >&2
  exit 1
fi

if ! command -v git >/dev/null 2>&1; then
  echo "Error: git is required." >&2
  exit 1
fi

if ! command -v ssh-keygen >/dev/null 2>&1; then
  echo "Error: ssh-keygen is required." >&2
  exit 1
fi

repo_name="$(basename "$(pwd)")"
key_comment="$(hostname)--${repo_name}"
key_dir=".git/ssh"
key_path="${key_dir}/id_ed25519"
pub_path="${key_path}.pub"

mkdir -p "$key_dir"
chmod 700 "$key_dir"

if [[ ! -f "$key_path" ]]; then
  ssh-keygen -t ed25519 -C "$key_comment" -f "$key_path" -N "" >/dev/null
fi

chmod 600 "$key_path"
ssh-keygen -y -f "$key_path" | awk -v comment="$key_comment" '{ print $1 " " $2 " " comment }' > "$pub_path"
chmod 644 "$pub_path"

git config --local core.sshCommand "ssh -i ${key_path} -o IdentitiesOnly=yes"

origin_url="$(git config --local --get remote.origin.url || true)"
case "$origin_url" in
  https://github.com/*)
    repo_path="${origin_url#https://github.com/}"
    repo_path="${repo_path%.git}"
    git config --local remote.origin.url "git@github.com:${repo_path}.git"
    ;;
  sshttps://github.com/*)
    repo_path="${origin_url#sshttps://github.com/}"
    repo_path="${repo_path%.git}"
    git config --local remote.origin.url "git@github.com:${repo_path}.git"
    ;;
esac

cat "$pub_path"
